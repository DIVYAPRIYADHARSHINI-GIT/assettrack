# SQLite database file (Prisma). Relative paths are resolved from backend/prisma/.
# On Render the blueprint uses file:./data/assettrack.db
DATABASE_URL=file:./dev.db
# Long random string used to sign JWTs (e.g. `openssl rand -hex 32`). Render generates one automatically.
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime (jsonwebtoken format: 15m, 8h, 1d ...)
JWT_EXPIRES_IN=8h
# Extra allowed browser origin(s) for CORS, comma separated, no trailing slash.
# Same-origin requests (the built frontend served by this backend) are always allowed.
# For local dev with Vite: http://localhost:5173
CORS_ORIGIN=http://localhost:5173
# Port the API listens on (Render sets this automatically)
PORT=4000
NODE_ENV=development
# Login attempts allowed per IP per 15 minutes
LOGIN_RATE_LIMIT=10
# Database used only by `npm test` (wiped on every run)
TEST_DATABASE_URL=file:./test.db
