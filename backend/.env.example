# PostgreSQL connection string. On Neon use the POOLED connection string here
# (host contains -pooler) and append ?sslmode=require&pgbouncer=true
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/assettrack_dev
# Direct (non-pooled) connection used by `prisma migrate`. Locally, same as DATABASE_URL.
DIRECT_URL=postgresql://USER:PASSWORD@localhost:5432/assettrack_dev
# Long random string used to sign JWTs (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime (jsonwebtoken format: 15m, 8h, 1d ...)
JWT_EXPIRES_IN=8h
# Allowed frontend origin(s), comma separated, no trailing slash
CORS_ORIGIN=http://localhost:5173
# Port the API listens on (Render sets this automatically)
PORT=4000
NODE_ENV=development
# Login attempts allowed per IP per 15 minutes
LOGIN_RATE_LIMIT=10
# Disposable database used only by `npm test` (name must contain "test")
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/assettrack_test
